# Absolute origin, used for metadataBase (Open Graph and manifest URLs).
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Supabase (@supabase/supabase-js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (@anthropic-ai/sdk). Server-side only — never prefix this
# with NEXT_PUBLIC_ or the key ships to the browser.
ANTHROPIC_API_KEY=
