# Absolute origin used for metadataBase (Open Graph and manifest URLs).
#
# Leave this COMMENTED OUT unless you have a custom domain. On Vercel the
# origin is derived from VERCEL_PROJECT_PRODUCTION_URL automatically. Setting
# the key with an empty value is worse than not setting it at all — the app
# tolerates it now, but an empty string is not a URL.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (@supabase/supabase-js). Leave both blank to run on the seed
# roster; the Clients header says which mode it is in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (@anthropic-ai/sdk). Server-side only — never prefix this
# with NEXT_PUBLIC_ or the key ships to the browser.
ANTHROPIC_API_KEY=
